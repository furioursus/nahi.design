---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
	image: ImageMetadata;
	alt: string;
	transitionName?: string;
}

const { image, alt, transitionName } = Astro.props;
---

<div class="hero-image-wrapper full-width-breakout">
	<div class="container">
		<Image src={image} alt={alt} transition:name={transitionName} />
	</div>
</div>

<style>
	.hero-image-wrapper {
		background-color: #000;
		padding: var(--space-10) 0;
	}

	.hero-image-wrapper img {
		width: 100%;
		height: 100%;
		display: block;
	}
</style>
