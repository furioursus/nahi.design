---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
	image: ImageMetadata | string;
	alt: string;
	transitionName?: string;
}

const { image, alt, transitionName } = Astro.props;
const isVideo = typeof image === "string";
---

<div class="hero-image-wrapper full-width-breakout">
	<div class="container">
		{
			isVideo ? (
				<video
					src={image}
					aria-label={alt}
					autoplay
					muted
					loop
					playsinline
					transition:name={transitionName}
				/>
			) : (
				<Image src={image} alt={alt} transition:name={transitionName} />
			)
		}
	</div>
</div>

<style>
	.hero-image-wrapper {
		background-color: #000;
		padding: var(--space-10) 0;
	}

	.hero-image-wrapper img,
	.hero-image-wrapper video {
		max-width: 100%;
		height: auto;
		display: block;
	}
</style>
