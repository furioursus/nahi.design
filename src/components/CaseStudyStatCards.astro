---
interface Props {
	heading?: string;
	columnNumber?: number;
	marginTop?: string;
}

const { heading, columnNumber = 5, marginTop = "var(--space-0)" } = Astro.props;
---

<div
	class="stat-cards-container inner-padding"
	style={`--margin-top: ${marginTop}`}
>
	{heading && <h3>{heading}</h3>}
	<div class="stat-cards" style={`--column-number: ${columnNumber}`}>
		<slot />
	</div>
</div>

<style>
	.stat-cards-container {
		margin-top: var(--margin-top);
	}

	h3 {
		font-family: var(--text-font-heading);
		font-size: var(--text-sm);
		color: var(--color-oubliette);
		line-height: var(--line-height-normal);
		margin-bottom: var(--space-2);
	}
	.stat-cards {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-2);
		justify-content: space-between;
		@media screen and (--bp-xs) {
			grid-template-columns: repeat(2, 1fr);
		}
		@media screen and (--bp-md) {
			grid-template-columns: repeat(var(--column-number), 1fr);
		}
	}
</style>
