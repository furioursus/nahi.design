---
import { Image } from "astro:assets";
import type { CaseStudyCard } from "@data/case-studies";

interface Props {
	card: CaseStudyCard;
}

const { card } = Astro.props;
---

<a class="card" href={`/case-studies/${card.slug}`}>
	<div class="card-img"><Image src={card.thumb} alt={card.thumbAlt} /></div>
	<div class="card-body">
		<div class="card-eyebrow">{card.eyebrow}</div>
		<div class="card-title">{card.title}</div>
		<div class="card-blurb">{card.blurb}</div>
		<div class="card-foot">
			<span class="card-meta">{card.meta}</span>
			<span class="card-cta">Read the case study <span class="card-arw">→</span></span>
		</div>
	</div>
</a>

<style>
	.card {
		position: relative;
		display: block;
		background: var(--surface);
		text-decoration: none;
		color: inherit;
		border: 1px solid var(--rule);
		border-radius: 3px;
		overflow: hidden;
		box-shadow: 0 0 0 0 transparent;
		transition:
			background var(--dur-s) var(--ease),
			border-color var(--dur-s) var(--ease),
			transform var(--dur-l) var(--ease),
			box-shadow var(--dur-l) var(--ease);
	}
	.card:hover {
		background: var(--accent-tint);
		border-color: var(--ink-soft);
		transform: scale(1.035);
		box-shadow: 0 32px 64px -16px rgba(30, 27, 23, 0.22);
		z-index: 1;
	}
	.card:hover .card-arw {
		transform: translateX(4px);
	}
	.card-img {
		position: relative;
		aspect-ratio: 8 / 5;
		overflow: hidden;
		background: var(--rule);
		border-bottom: 1px solid var(--rule);
	}
	.card-img :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform var(--dur-l) var(--ease);
	}
	.card-body {
		padding: 26px 30px 26px;
	}
	.card-eyebrow {
		font-family: var(--font-mono);
		font-size: 10.5px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-soft);
		margin-bottom: 14px;
	}
	.card-title {
		font-family: var(--font-display);
		font-size: 20px;
		font-weight: 500;
		line-height: 1.3;
		color: var(--ink);
		margin-bottom: 11px;
		letter-spacing: -0.01em;
	}
	.card-blurb {
		font-size: 14px;
		line-height: 1.75;
		color: var(--ink-mid);
		margin-bottom: 20px;
	}
	.card-foot {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		padding-top: 16px;
		border-top: 1px solid var(--rule);
	}
	.card-meta {
		font-family: var(--font-mono);
		font-size: 10.5px;
		letter-spacing: 0.06em;
		color: var(--ink-soft);
	}
	.card-cta {
		display: inline-flex;
		align-items: baseline;
		gap: 7px;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.05em;
		color: var(--accent);
		white-space: nowrap;
	}
	.card-arw {
		display: inline-block;
		transition: transform var(--dur-s) var(--ease);
	}
</style>
