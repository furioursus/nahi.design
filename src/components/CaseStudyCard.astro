---
import { Image } from "astro:assets";
import type { CaseStudyCard } from "@data/case-studies";
import { panelArt } from "@data/panel-art";

interface Props {
	card: CaseStudyCard;
	wireframe: "a" | "b" | "c" | "d";
	tear?: "a" | "b" | "c";
	id?: string;
}

const { card, wireframe, tear, id } = Astro.props;
// Reversed so the first piece listed paints on top, as it did when these were stacked background-image layers.
const art = [...panelArt[wireframe]].reverse();
---

<section
	class="panel cs-panel"
	id={id}
	data-texture="dots-32"
	data-tear={tear}
	data-label={card.label}
>
	<div class="panel-art" aria-hidden="true">
		{art.map((p) => (
			<span
				data-still={p.still}
				style={`background-image:var(${p.art});width:${p.w}px;height:${p.h}px;${p.pos}`}
			/>
		))}
	</div>
	<div class="panel-inner wrap">
		<a class="cs-content" href={`/case-studies/${card.slug}`}>
			<div class="cs-media">
				<Image src={card.thumb} alt={card.thumbAlt} />
			</div>
			<div class="cs-text">
				<div class="card-eyebrow">{card.eyebrow}</div>
				<h2 class="cs-title">{card.title}</h2>
				<p class="card-blurb">{card.blurb}</p>
				<div class="card-foot">
					<span class="card-meta">{card.meta}</span>
					<span class="card-cta">
						Read the case study <span class="card-arw">→</span>
					</span>
				</div>
			</div>
		</a>
	</div>
</section>

<style>
	.cs-content {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 26px;
		max-width: 1000px;
		margin: 0 auto;
		padding: 40px 20px;
		border: 1px solid var(--rule);
		border-radius: 4px;
		background-color: var(--paper);
		text-decoration: none;
		color: inherit;
		cursor: pointer;
		transition:
			box-shadow var(--dur-m) var(--ease),
			border-color var(--dur-s) var(--ease);
	}
	.cs-content:hover {
		box-shadow: 0 28px 52px -18px rgba(30, 27, 23, 0.22);
		border-color: var(--ink-soft);
	}
	.cs-content:hover .card-arw {
		transform: translateX(4px);
	}
	@media (max-height: 800px) {
		.cs-content {
			padding: 10px 5px;
			gap: 14px;
		}
	}
	.cs-media {
		width: 100%;
		max-width: 560px;
		margin: 0 auto;
		aspect-ratio: 2 / 1;
		border-radius: 3px;
		overflow: hidden;
		border: 1px solid var(--rule);
		background: var(--rule);
	}
	.cs-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		display: block;
	}
	.cs-text {
		padding: 20px 12px;
		text-align: left;
		background-color: var(--paper);
	}
	.cs-title {
		font-family: var(--font-display);
		font-size: clamp(26px, 2.8vw, 34.5px);
		font-weight: 500;
		line-height: 1.28;
		letter-spacing: -0.015em;
		color: var(--ink);
		margin: 0 0 16px;
	}
	.card-eyebrow {
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-soft);
		margin-bottom: 14px;
	}
	.card-blurb {
		font-size: 15px;
		line-height: 1.75;
		color: var(--ink-mid);
		margin-bottom: 20px;
	}
	.card-foot {
		display: flex;
		align-items: baseline;
		justify-content: flex-start;
		gap: 20px;
		padding-top: 16px;
		border-top: 1px solid var(--rule);
	}
	.card-meta {
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: 0.06em;
		color: var(--ink-soft);
	}
	.card-cta {
		display: inline-flex;
		align-items: baseline;
		gap: 7px;
		font-family: var(--font-ui);
		font-size: 12px;
		letter-spacing: 0.05em;
		color: var(--accent);
		white-space: nowrap;
	}
	.card-arw {
		display: inline-block;
		transition: transform var(--dur-s) var(--ease);
	}
	@media (max-width: 600px) {
		.cs-title {
			font-size: 24px;
		}
	}
</style>
