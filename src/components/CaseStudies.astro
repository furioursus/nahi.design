---
import CaseStudyCard from "@components/CaseStudyCard.astro";
import { caseStudies } from "@data/case-studies";

const wireframes = ["a", "b", "c", "d"] as const;
const tears = ["b", "c", undefined, "b"] as const;
---

{caseStudies.map((card, i) => <CaseStudyCard card={card} wireframe={wireframes[i]} tear={tears[i]} id={i === 0 ? "work" : undefined} />)}
