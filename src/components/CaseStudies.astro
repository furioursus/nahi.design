---
import CaseStudyCard from "@components/CaseStudyCard.astro";
import { caseStudies } from "@data/case-studies";
import "@styles/homepage-panels.css";

const tears = ["b", "c", undefined, "b"] as const;
---

{caseStudies.map((card, i) => <CaseStudyCard card={card} wireframe={card.wireframe} tear={tears[i]} id={i === 0 ? "work" : undefined} />)}
