---
import { caseStudies } from "@data/case-studies";
import SectionHeading from "./SectionHeading.astro";
import CaseStudyThumb from "./CaseStudyThumb.astro";
---

<div class="container" id="case-studies">
	<main>
		<SectionHeading
			title="Case Studies"
			number={1}
			caption="NDAs, we know the drill."
			numberLeadSmall
		/>
		<div class="case-studies-grid">
			{
				caseStudies.map((study) => (
					<CaseStudyThumb
						title={study.title}
						info={study.tags}
						status={study.status}
						statusLastUpdated={study.statusLastUpdated}
						summary={study.thumbSummary}
						gridThumbImage={study.gridThumbImage}
						href={`/case-studies/${study.id}`}
						transitionName={`hero-image-${study.id}`}
					/>
				))
			}
		</div>
	</main>
</div>

<style>
	main {
		padding-top: var(--space-4);
		padding-bottom: var(--space-10);
		@media (min-width: 48rem) {
			margin-top: var(--space-10);
			padding-top: var(--space-10);
			padding-bottom: var(--space-20);
			border-top: 1px solid var(--color-dovetail);
		}
	}

	.case-studies-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-10);
		margin-top: var(--space-12);

		@media (min-width: 48rem) {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
