---
import CaseStudyCard from "@components/CaseStudyCard.astro";
import { caseStudies } from "@data/case-studies";
import "@styles/homepage-panels.css";

const tears = ["b", "c", undefined, "b"] as const;
---

{caseStudies.map((card, i) => (
	<CaseStudyCard
		card={card}
		wireframe={card.wireframe}
		tear={tears[i]}
		id={i === 0 ? "work" : undefined}
	/>
))}

<script>
	// Hover easter egg on the panel sketches — see docs/homepage-panel-art.md.
	const moves: Keyframe[][] = [
		// wobble
		[
			{ transform: "rotate(0)" },
			{ transform: "rotate(-5deg)" },
			{ transform: "rotate(4deg)" },
			{ transform: "rotate(-2.5deg)" },
			{ transform: "rotate(1deg)" },
			{ transform: "rotate(0)" },
		],
		// bounce
		[
			{ transform: "translateY(0) scale(1, 1)" },
			{ transform: "translateY(-12px) scale(0.97, 1.04)", offset: 0.3 },
			{ transform: "translateY(0) scale(1.05, 0.94)", offset: 0.55 },
			{ transform: "translateY(-4px) scale(1, 1)", offset: 0.75 },
			{ transform: "translateY(0) scale(1, 1)" },
		],
		// boing
		[
			{ transform: "scale(1)" },
			{ transform: "scale(1.08)", offset: 0.25 },
			{ transform: "scale(0.95)", offset: 0.5 },
			{ transform: "scale(1.02)", offset: 0.75 },
			{ transform: "scale(1)" },
		],
	];
	const motionOk =
		!matchMedia("(prefers-reduced-motion: reduce)").matches &&
		"animate" in Element.prototype;
	if (motionOk) {
		document.addEventListener("pointerover", (e) => {
			if (e.pointerType === "touch") return;
			const el = (e.target as Element).closest?.(
				".panel-art > span:not([data-still])",
			);
			if (!el || el.getAnimations().length) return;
			el.animate(moves[Math.floor(Math.random() * moves.length)], {
				duration: 650,
				easing: "ease-out",
			});
		});
	}
</script>
