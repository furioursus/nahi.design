---
// Ported from furioursus/furioursus.dev's Lightbox.astro — this repo has no markdown/blog
// pipeline, so only the explicit-usage half made the trip (see LightboxImage.astro). Behavior is
// otherwise unchanged: registers the <lightbox-image> custom element and moves (not clones) the
// image into the dialog on open, so it's the same already-loaded element, no extra request.
// Included once, globally, in BaseLayout.astro.
---

<script>
	class LightboxImage extends HTMLElement {
		connectedCallback() {
			const trigger = this.querySelector<HTMLButtonElement>(":scope > .lightbox-trigger");
			const dialog = this.querySelector<HTMLDialogElement>(":scope > dialog.lightbox-dialog");
			const closeButton = dialog?.querySelector<HTMLButtonElement>(".lightbox-close");
			const triggerImg = trigger?.querySelector("img");
			// Usually the dialog starts with no <img> of its own — the trigger's gets moved in on
			// open (see below). But when LightboxImage.astro was given explicit width/height, the
			// dialog is pre-rendered with its own separate, full-resolution <img> instead: astro:assets
			// generates a real resized (and possibly cropped) file for the thumbnail, so there's no way
			// to "un-shrink" it by moving it. In that case leave it alone; there's nothing to move.
			const dialogOwnImg = dialog?.querySelector("img");

			if (!trigger || !dialog || !triggerImg) {
				console.warn("Lightbox: missing trigger, dialog, or image element");
				return;
			}

			trigger.addEventListener("click", () => {
				if (!dialogOwnImg) {
					// Move (not clone) the image into the dialog — same element, same already-loaded
					// src, no extra request. Inserted before the dialog's own caption (if any) so the
					// image renders above it, not below.
					const dialogCaption = dialog.querySelector(".lightbox-caption");
					if (dialogCaption) {
						dialog.insertBefore(triggerImg, dialogCaption);
					} else {
						dialog.appendChild(triggerImg);
					}
				}
				dialog.showModal();
			});

			closeButton?.addEventListener("click", () => dialog.close());

			// Click on the backdrop (outside the image) closes the dialog.
			dialog.addEventListener("click", (e) => {
				if (e.target === dialog) dialog.close();
			});

			// Fires uniformly for Escape, the close button, and backdrop clicks.
			dialog.addEventListener("close", () => {
				if (!dialogOwnImg) {
					trigger.appendChild(triggerImg);
				}
				trigger.focus();
			});
		}
	}

	customElements.define("lightbox-image", LightboxImage);
</script>
