---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<div class="deck-cta">
	<button class="deck-cta-btn" type="button" aria-haspopup="dialog">
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
			><rect x="2" y="3" width="20" height="14" rx="1"></rect><path d="M8 21h8M12 17v4"></path></svg
		>
		View as deck
	</button>
</div>

<div class="deck-lb" id="deckLb" hidden role="dialog" aria-modal="true" aria-label="Slide deck">
	<div class="deck-bar">
		<span class="deck-bar-label"><span class="spine"></span><span>{title} · deck</span></span>
		<span class="deck-bar-src" id="deckSrc"></span>
		<span class="deck-bar-count" id="deckCount"></span>
		<button class="deck-bar-x" id="deckClose" type="button" aria-label="Close deck">×</button>
	</div>
	<div class="deck-stage">
		<button class="deck-arw" id="deckPrev" type="button" aria-label="Previous slide">‹</button>
		<div class="deck-canvas" id="deckCanvas"></div>
		<button class="deck-arw" id="deckNext" type="button" aria-label="Next slide">›</button>
	</div>
	<div class="deck-rail" id="deckRail"></div>
	<div class="deck-hint"><span class="kb">← → to navigate · Esc to close</span><span class="sw">Swipe to navigate</span></div>
</div>

<script>
	/* View-as-deck lightbox. Builds its slide list from the page itself —
	   .deck-stat elements, figure[data-deck], .pull quotes, and .metrics —
	   in document order, so the deck mirrors the reading order of the
	   case study without a separate slide list to maintain. */
	(function () {
		const lb = document.getElementById("deckLb") as HTMLElement | null;
		if (!lb) return;
		const deckLb = lb;
		const canvas = document.getElementById("deckCanvas")!,
			rail = document.getElementById("deckRail")!,
			countEl = document.getElementById("deckCount")!,
			srcEl = document.getElementById("deckSrc")!,
			closeBtn = document.getElementById("deckClose") as HTMLButtonElement,
			prevBtn = document.getElementById("deckPrev") as HTMLButtonElement,
			nextBtn = document.getElementById("deckNext") as HTMLButtonElement,
			stageEl = document.querySelector(".deck-stage") as HTMLElement | null;
		let slides: any[] = [],
			idx = 0,
			opener: HTMLElement | null = null;

		function text(el: Element | null) {
			return el ? el.textContent!.trim() : "";
		}

		function sectionInfo(el: Element) {
			const sec = el.closest ? el.closest("section[id]") : null;
			if (!sec) return { num: "", label: "" };
			const n = sec.querySelector(".sec-num"),
				h = sec.querySelector("h2");
			return { num: n ? text(n) : "", label: h ? text(h) : sec.id };
		}

		function buildTitle() {
			const eyebrow = Array.from(document.querySelectorAll(".hero .eyebrow > span"))
				.map(text)
				.filter((t) => t && t !== "·")
				.join(" · ");
			const h1 = text(document.querySelector(".hero h1"));
			const lede = text(document.querySelector(".hero .lede"));
			const first = lede.split(/(?<=[.?!])\s+/)[0] || "";
			return { type: "title", label: "Title", source: "Hero", eyebrow, html: h1, sub: first };
		}

		function lbl(el: Element, def: string) {
			return el.getAttribute("data-deck-label") || def;
		}

		function buildStatement(el: Element) {
			const info = sectionInfo(el);
			const eyebrow =
				el.getAttribute("data-deck-eyebrow") || (info.num ? info.num + " · " + info.label : info.label);
			const foot = el.getAttribute("data-deck-foot");
			let fk = "",
				fv = "";
			if (foot) {
				const parts = foot.split("|");
				fk = (parts[0] || "").trim();
				fv = (parts[1] || "").trim();
			}
			return {
				type: "statement",
				label: lbl(el, info.label || "Statement"),
				source: info.label || "Statement",
				eyebrow,
				html: (el as HTMLElement).innerHTML.trim(),
				fk,
				fv,
			};
		}

		/* A caption is the .fn label plus a span; the span may carry a bold
		   .fig-lead. We keep its HTML so the lead stays bold on the slide. */
		function captionOf(fig: Element) {
			const cap = fig.querySelector("figcaption, .strip-cap");
			if (!cap) return { fn: "", html: "" };
			const fn = text(cap.querySelector(".fn"));
			const span = cap.querySelector("span:not(.fn)");
			return { fn, html: span ? (span as HTMLElement).innerHTML.trim() : esc(cap.textContent!.replace(fn, "").trim()) };
		}

		/* Placeholder frame text without its bold "Figure 0N" label. */
		function tagText(tag: Element | null) {
			if (!tag) return "";
			const c = tag.cloneNode(true) as HTMLElement;
			const b = c.querySelector("b");
			if (b) b.parentNode!.removeChild(b);
			return c.textContent!.trim();
		}

		function cellOf(frame: Element, i: number) {
			const img = frame.querySelector("img"),
				tag = frame.querySelector(".frame-tag");
			const n = frame.querySelector(".frame-n");
			return {
				img: img ? img.getAttribute("src") : null,
				fit: frame.getAttribute("data-fit") || "",
				alt: img ? img.getAttribute("alt") || "" : tagText(tag),
				n: n ? text(n) : String(i + 1).padStart(2, "0"),
				label: frame.getAttribute("data-label") || "",
			};
		}

		/* A figure holding motion instead of a still: same slide shape as an
		   image, carrying poster + sources so the deck can rebuild <video>
		   with the autoplay/reduced-motion handling BaseLayout gives the
		   page's own copy (which this cloned markup doesn't get for free). */
		function videoInfo(video: Element) {
			return {
				poster: video.getAttribute("poster") || "",
				sources: Array.from(video.querySelectorAll("source")).map((s) => ({
					src: s.getAttribute("src") || "",
					media: s.getAttribute("media"),
				})),
			};
		}

		function buildImage(fig: Element) {
			const info = sectionInfo(fig);
			const img = fig.querySelector("img");
			const video = !img ? fig.querySelector("video") : null;
			const tag = fig.querySelector(".frame-tag");
			const cap = captionOf(fig);
			return {
				type: "image",
				fit: fig.getAttribute("data-fit") || "",
				label: lbl(fig, info.label || "Image"),
				source: info.label || "Hero",
				img: img ? img.getAttribute("src") : null,
				video: video ? videoInfo(video) : null,
				alt: img ? img.getAttribute("alt") || "" : video ? video.getAttribute("aria-label") || "" : tagText(tag),
				fn: cap.fn,
				cap: cap.html,
			};
		}

		/* strip: any container with data-deck="strip" — its .frame children become
		   side-by-side cells. Caption from .strip-cap or data-deck-caption. */
		function buildStrip(el: Element) {
			const info = sectionInfo(el);
			const cells = Array.from(el.querySelectorAll(".frame")).map(cellOf);
			const cap = captionOf(el);
			const custom = el.getAttribute("data-deck-caption");
			return {
				type: "strip",
				stack: el.hasAttribute("data-deck-stack"),
				label: lbl(el, info.label || "Sequence"),
				source: info.label || "Sequence",
				eyebrow: info.num ? info.num + " · " + info.label : info.label,
				cells,
				fn: custom ? "" : cap.fn,
				cap: custom ? esc(custom) : cap.html,
			};
		}

		/* strip with data-deck-solo: too much detail per frame to share one slide
		   (dense screenshots, not simple diagrams) — give each frame its own
		   full-size image slide instead of squeezing them side by side or stacked. */
		function buildStripSolo(el: Element) {
			const info = sectionInfo(el);
			const cap = captionOf(el);
			const custom = el.getAttribute("data-deck-caption");
			const fn = custom ? "" : cap.fn,
				capHtml = custom ? esc(custom) : cap.html;
			return Array.from(el.querySelectorAll(".frame")).map((frame, i) => {
				const c = cellOf(frame, i);
				return {
					type: "image",
					fit: c.fit,
					label: c.label || info.label || "Image",
					source: info.label || "Sequence",
					img: c.img,
					alt: c.alt,
					fn,
					cap: c.label ? esc(c.label) : capHtml,
				};
			});
		}

		/* pair: data-deck="pair" on an .img-2 — two figures, each keeps its own caption. */
		function buildPair(el: Element) {
			const info = sectionInfo(el);
			const figs = Array.from(el.querySelectorAll("figure"));
			const cells = figs.map((f, i) => {
				const c = cellOf(f, i);
				const cap = captionOf(f);
				(c as any).n = cap.fn || c.n;
				(c as any).cap = cap.html;
				return c;
			});
			return {
				type: "pair",
				label: lbl(el, info.label || "Pair"),
				source: info.label || "Pair",
				eyebrow: info.num ? info.num + " · " + info.label : info.label,
				cells,
			};
		}

		function buildQuote(pull: Element) {
			const q = pull.querySelector(".pull-q"),
				a = pull.querySelector(".pull-a");
			return { type: "quote", label: lbl(pull, "Quote"), source: "Quote", q: q ? q.textContent!.trim() : "", a: a ? a.textContent!.trim() : "" };
		}

		function buildMetrics(box: Element) {
			const info = sectionInfo(box);
			const items = Array.from(box.querySelectorAll(".metric")).map((m) => ({
				n: text(m.querySelector(".metric-n")),
				l: text(m.querySelector(".metric-l")),
			}));
			return {
				type: "metrics",
				label: lbl(box, info.label || "Outcome"),
				source: info.label || "Outcome",
				eyebrow: info.num ? info.num + " · " + info.label : info.label,
				items,
			};
		}

		function buildSlides() {
			const list: any[] = [buildTitle()];
			Array.from(document.querySelectorAll('.pull, figure[data-deck], [data-deck="strip"], [data-deck="pair"], .deck-stat, .metrics')).forEach(
				(el) => {
					const kind = el.getAttribute("data-deck");
					if (el.classList.contains("pull")) list.push(buildQuote(el));
					else if (el.tagName === "FIGURE") list.push(buildImage(el));
					else if (kind === "strip") (el.hasAttribute("data-deck-solo") ? buildStripSolo(el) : [buildStrip(el)]).forEach((s) => list.push(s));
					else if (kind === "pair") list.push(buildPair(el));
					else if (el.classList.contains("metrics")) list.push(buildMetrics(el));
					else if (el.classList.contains("deck-stat")) list.push(buildStatement(el));
				},
			);
			return list;
		}

		function esc(s: string | null) {
			return (s || "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
		}

		function videoHtml(v: { poster: string; sources: { src: string; media: string | null }[] }, alt: string) {
			const sources = v.sources
				.map((s) => '<source src="' + s.src + '"' + (s.media ? ' media="' + esc(s.media) + '"' : "") + ' type="video/mp4">')
				.join("");
			return (
				'<video autoplay muted loop playsinline data-ambient poster="' +
				esc(v.poster) +
				'" aria-label="' +
				esc(alt) +
				'">' +
				sources +
				"</video>"
			);
		}

		/* Slides are rebuilt from innerHTML after the page's own load event, so
		   BaseLayout's one-time data-ambient play pass never sees them — give
		   each freshly rendered slide the same reduced-motion-respecting start. */
		function playAmbient(root: Element) {
			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
			root.querySelectorAll<HTMLVideoElement>("video[data-ambient]").forEach((v) => v.play().catch(() => {}));
		}

		function cellHtml(c: any) {
			const media = c.img ? '<img src="' + c.img + '" alt="' + esc(c.alt) + '">' : esc(c.alt);
			return (
				'<div class="ds-cell' +
				(c.fit ? " " + c.fit : "") +
				'"><span class="ds-cell-n">' +
				esc(c.n) +
				"</span>" +
				media +
				(c.label ? '<span class="ds-cell-l">' + esc(c.label) + "</span>" : "") +
				"</div>"
			);
		}

		function renderSlide(s: any) {
			if (s.type === "title") {
				canvas.innerHTML =
					'<div class="deck-slide"><div class="ds-eye"><span class="spine"></span>' +
					esc(s.eyebrow) +
					'</div><div class="ds-h">' +
					esc(s.html) +
					"</div>" +
					(s.sub ? '<div class="ds-sub">' + esc(s.sub) + "</div>" : "") +
					"</div>";
			} else if (s.type === "statement") {
				canvas.innerHTML =
					'<div class="deck-slide"><div class="ds-eye"><span class="spine"></span>' +
					esc(s.eyebrow) +
					'</div><div class="ds-h">' +
					s.html +
					"</div>" +
					(s.fk || s.fv
						? '<div class="ds-foot"><span class="ds-fk">' + esc(s.fk) + '</span><span class="ds-fv">' + esc(s.fv) + "</span></div>"
						: "") +
					"</div>";
			} else if (s.type === "image") {
				const media = s.img
					? '<img src="' + s.img + '" alt="' + esc(s.alt) + '">'
					: s.video
						? videoHtml(s.video, s.alt)
						: esc(s.alt || "Image");
				canvas.innerHTML =
					'<div class="deck-slide" style="padding-bottom:5.5%"><div class="ds-media' +
					(s.fit ? " " + s.fit : "") +
					'">' +
					media +
					'</div><div class="ds-cap"><b>' +
					esc(s.fn) +
					"</b><span>" +
					s.cap +
					"</span></div></div>";
				playAmbient(canvas);
			} else if (s.type === "strip") {
				canvas.innerHTML =
					'<div class="deck-slide"><div class="ds-eye"><span class="spine"></span>' +
					esc(s.eyebrow) +
					'</div><div class="ds-strip' +
					(s.stack ? " stack" : "") +
					'" style="--n:' +
					s.cells.length +
					'">' +
					s.cells.map(cellHtml).join("") +
					"</div>" +
					(s.cap ? '<div class="ds-cap">' + (s.fn ? "<b>" + esc(s.fn) + "</b>" : "") + "<span>" + s.cap + "</span></div>" : "") +
					"</div>";
			} else if (s.type === "pair") {
				const caps = s.cells
					.map((c: any) => (c.cap ? '<div class="ds-cap"><b>' + esc(c.n) + "</b><span>" + c.cap + "</span></div>" : ""))
					.join("");
				canvas.innerHTML =
					'<div class="deck-slide"><div class="ds-eye"><span class="spine"></span>' +
					esc(s.eyebrow) +
					'</div><div class="ds-strip" style="--n:' +
					s.cells.length +
					'">' +
					s.cells.map((c: any) => cellHtml({ img: c.img, fit: c.fit, alt: c.alt, n: c.n, label: "" })).join("") +
					"</div>" +
					caps +
					"</div>";
			} else if (s.type === "quote") {
				canvas.innerHTML = '<div class="deck-slide"><div class="ds-q">' + esc(s.q) + '</div><div class="ds-qa">' + esc(s.a) + "</div></div>";
			} else if (s.type === "metrics") {
				const cols = s.items
					.map((m: any) => '<div class="ds-col"><div class="ds-cn">' + esc(m.n) + '</div><div class="ds-cl">' + esc(m.l) + "</div></div>")
					.join("");
				canvas.innerHTML =
					'<div class="deck-slide"><div class="ds-eye"><span class="spine"></span>' +
					esc(s.eyebrow) +
					'</div><div class="ds-cols" style="--n:' +
					s.items.length +
					'">' +
					cols +
					"</div></div>";
			}
		}

		function renderRail() {
			rail.innerHTML = "";
			slides.forEach((s, i) => {
				const th = document.createElement("button");
				th.type = "button";
				th.className = "deck-th";
				if (i === idx) th.setAttribute("data-on", "");
				th.innerHTML = '<span class="deck-th-n">' + (i + 1) + '</span><span class="deck-th-t">' + esc(s.label) + "</span>";
				th.addEventListener("click", () => go(i));
				rail.appendChild(th);
			});
		}

		function go(i: number) {
			idx = (i + slides.length) % slides.length;
			renderSlide(slides[idx]);
			countEl.textContent = idx + 1 + " / " + slides.length;
			srcEl.textContent = "From: " + slides[idx].source;
			Array.from(rail.children).forEach((th, i2) => {
				if (i2 === idx) {
					th.setAttribute("data-on", "");
					if (rail.scrollWidth > rail.clientWidth)
						rail.scrollLeft = (th as HTMLElement).offsetLeft - rail.clientWidth / 2 + (th as HTMLElement).offsetWidth / 2;
				} else th.removeAttribute("data-on");
			});
		}

		function open(i: number) {
			if (!slides.length) slides = buildSlides();
			if (!slides.length) return;
			opener = document.activeElement as HTMLElement;
			deckLb.hidden = false;
			document.documentElement.style.overflow = "hidden";
			renderRail();
			go(i || 0);
			document.addEventListener("keydown", onKey);
			closeBtn.focus();
		}

		function close() {
			deckLb.hidden = true;
			document.documentElement.style.overflow = "";
			document.removeEventListener("keydown", onKey);
			if (opener && opener.focus) opener.focus();
		}

		function onKey(e: KeyboardEvent) {
			if (e.key === "Escape") close();
			else if (e.key === "ArrowRight") go(idx + 1);
			else if (e.key === "ArrowLeft") go(idx - 1);
		}

		Array.from(document.querySelectorAll(".deck-trigger, .deck-cta-btn")).forEach((btn) => {
			btn.addEventListener("click", () => open(0));
		});
		closeBtn.addEventListener("click", close);
		prevBtn.addEventListener("click", () => go(idx - 1));
		nextBtn.addEventListener("click", () => go(idx + 1));
		lb.addEventListener("click", (e) => {
			if (e.target === lb) close();
		});

		let tX = 0;
		if (stageEl) {
			stageEl.addEventListener(
				"touchstart",
				(e) => {
					tX = e.changedTouches[0].clientX;
				},
				{ passive: true },
			);
			stageEl.addEventListener(
				"touchend",
				(e) => {
					const dx = e.changedTouches[0].clientX - tX;
					if (Math.abs(dx) > 40) go(idx + (dx < 0 ? 1 : -1));
				},
				{ passive: true },
			);
		}
	})();
</script>
