---
import homepage03 from "@img/homepage-03.png";
import homepage04 from "@img/homepage-04.png";
---

<section id="about">
	<div class="sec-head"><h2>About me</h2><span class="sec-rule"></span></div>
	<div class="about">
		<div
			class="about-photo"
			role="img"
			aria-label="Woodblock print portrait of Nahi Kennedy-Nuñez"
			style={`--mask-1:url('${homepage03.src}');--mask-2:url('${homepage04.src}')`}
		>
		</div>
		<p class="about-text">
			I'm a <strong>product and UX designer</strong> working mostly in and around AI and data-heavy tools, where
			the hard part is rarely the interface. It's deciding what the interface is allowed to leave out. I'm based
			in New York and currently looking for a full-time seat on a mission-driven team.
		</p>
	</div>
</section>

<style>
	.about {
		display: flex;
		align-items: center;
		gap: 26px;
	}
	.about-photo {
		width: 164px;
		height: 173px;
		flex-shrink: 0;
		background-color: var(--ink);
		-webkit-mask: var(--mask-1) center / contain no-repeat;
		mask: var(--mask-2) center / contain no-repeat;
	}
	.about-text {
		font-size: 14.5px;
		line-height: 1.75;
		color: var(--ink-mid);
		max-width: 560px;
	}
	@media (max-width: 600px) {
		.about {
			flex-direction: column;
			align-items: flex-start;
			gap: 18px;
		}
	}
</style>
