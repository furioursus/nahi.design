---
import SectionHeading from "./SectionHeading.astro";
import Description from "./Description.astro";
import Button from "./Button.astro";

interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={["contact named-hash", { compact }]} id="contact">
	<div class="container">
		<div class="section-inner">
			<SectionHeading
				title="Contact Info"
				number={3}
				caption="Why did 213 show up on your caller ID?"
			/>
			<Description
				color="var(--color-oubliette)"
				margin="var(--space-4) 0 var(--space-5)"
			>
				I’m a Senior UX Designer based in NYC, currently exploring full-time
				opportunities with mission-driven organizations where thoughtful design
				can make a real difference. If you’re working on something meaningful,
				I’d love to hear from you.
			</Description>
			<div class="button-container">
				<Button href="/nahi-kennedy-nunez-resume.pdf">Download Resume</Button>
				<Button href="mailto:hello@nahi.design" obfuscate>Email Me</Button>
			</div>
		</div>
	</div>
</div>

<style>
	.contact {
		padding: var(--space-20) 0;
		&.compact {
			padding: var(--space-10) 0;
		}
	}
	@media screen and (min-width: 48rem) {
		.contact {
			padding: var(--space-80) 0;
			&.compact {
				padding: var(--space-20) 0;
			}
		}
	}
	.button-container {
		display: inline-flex;
		flex-direction: column;
		gap: var(--space-7);
		@media screen and (min-width: 48rem) {
			flex-direction: row;
		}
	}
</style>
