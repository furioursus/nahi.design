---
import SectionHeading from "./SectionHeading.astro";
import Description from "./Description.astro";
import Button from "./Button.astro";

interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={["contact", { compact }]} id="contact">
	<div class="container">
		<div class="section-inner">
			<SectionHeading
				title="Contact Info"
				number={3}
				caption="Why did 213 show up on your caller ID?"
			/>
			<Description
				color="var(--color-oubliette)"
				margin="var(--space-4) 0 var(--space-5)"
			>
				I'm a Senior UX Designer based in NYC, currently exploring full-time
				opportunities with mission-driven organizations where thoughtful design
				can make a real difference. If you're working on something meaningful,
				I'd love to hear from you.
			</Description>
			<div class="button-container">
				<Button href="/resume.pdf">Download Resume</Button>
				<Button href="mailto:hello@nahi.design">Email Me</Button>
			</div>
		</div>
	</div>
</div>

<style>
	.contact {
		margin: 26rem 0;
	}
	.contact.compact {
		margin: 8rem 0;
	}
	.button-container {
		display: flex;
		gap: var(--space-7);
	}
</style>
