---
import Caption from "./Caption.astro";
export interface Props {
	title: string;
	number?: number;
	caption?: string;
	numberLeadSmall?: boolean;
}

const { title, number, caption, numberLeadSmall } = Astro.props;
---

<h2>
	{
		number ? (
			<span
				class:list={[
					numberLeadSmall ? "number-lead lead-small" : "number-lead",
				]}
			>
				{number < 10 ? `0${number}` : `${number}`}
			</span>
		) : null
	}
	<span class="title">{title}</span>
	{caption ? <Caption classes="grid-caption">{caption}</Caption> : null}
</h2>

<style>
	h2 {
		font-family: var(--text-font-heading);
		font-size: var(--text-2xl);
		font-weight: var(--weight-bold);
		line-height: var(--line-height-tight);
		letter-spacing: var(--letter-spacing-tighter);
		display: flex;
		flex-direction: column;
		@media screen and (min-width: 30rem) {
			font-size: var(--text-3xl);
		}
		@media screen and (min-width: 64rem) {
			font-size: var(--text-4xl);
			align-items: center;
			flex-direction: row;
		}
	}

	.number-lead {
		display: block;
		font-size: var(--text-3xs);
		font-weight: var(--weight-regular);
		color: var(--color-dovetail);
		font-style: italic;
		line-height: var(--line-height-tight);
		letter-spacing: var(--letter-spacing-tight);
		width: var(--space-10);
		@media screen and (min-width: 64rem) {
			align-self: flex-start;
			padding-top: calc(var(--text-4xl) / 2 + 2px);
		}
		&.lead-small {
			width: var(--space-6);
		}
	}

	.title {
		flex: 1;
	}
</style>

<style is:global>
	.grid-caption {
		grid-column: 2;
		@media screen and (min-width: 48rem) {
			text-align: right;
			grid-column: initial;
		}
	}
</style>
