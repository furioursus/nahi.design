---
interface Props {
	marginBottom?: boolean;
}

const { marginBottom } = Astro.props;
---

<div class:list={["browline", "eyebrow", { "above-heading": marginBottom }]}>
	<slot />
</div>

<style>
	.browline {
		font-weight: var(--weight-regular);
	}
	.above-heading {
		margin-bottom: var(--space-4);
	}
</style>
