---
interface Props {
	caption: string;
	columns: string[];
	rows: string[][];
}

const { caption, columns, rows } = Astro.props;
---

<div class="data-table rev">
	<table>
		<caption>{caption}</caption>
		<thead>
			<tr>{columns.map((col) => <th scope="col">{col}</th>)}</tr>
		</thead>
		<tbody>
			{
				rows.map(([head, ...cells]) => (
					<tr>
						<th scope="row">{head}</th>
						{cells.map((cell, i) => (
							<td data-label={columns[i + 1]}>{cell}</td>
						))}
					</tr>
				))
			}
		</tbody>
	</table>
</div>
