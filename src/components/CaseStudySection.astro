---
interface Props {
	paddingBottom?: boolean;
}

const { paddingBottom } = Astro.props;
---

<section class:list={paddingBottom ? "padding-bottom-huge" : undefined}>
	<slot />
</section>

<style>
	section {
		padding: var(--space-10) 0;
		@media screen and (min-width: 64rem) {
			padding: var(--space-20) 0;
		}
		&.padding-bottom-huge {
			padding-bottom: var(--space-40);
			@media screen and (min-width: 64rem) {
				padding-bottom: var(--space-80);
			}
		}
	}
</style>
