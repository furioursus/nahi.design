---
import Caption from "./Caption.astro";
import Description from "./Description.astro";
const VideoUrls = ["/video/woodworking.mp4", "/video/pea-puffer.mp4", "/video/mercer-lab.mp4", "/video/dante.mp4"];
---

<div class="about-nahi" id="about-nahi">
	<div class="container">
		<div class="section-inner">
			<Caption>Grounded • Craftsman</Caption>
			<h2 class="h1">Nahi Kennedy&#8209;Nuñez</h2>
			<Description>
				I'm a UX designer with a steady, disciplined approach to my craft —
				equally at home shaping wood by hand, watching my fish drift through
				their little world, getting outvoted by my two cats, or losing an
				afternoon to a good museum.
			</Description>
			<div class="video-grid">
				{VideoUrls.map((video) => (
					<video autoplay muted playsinline loop>
						<source src={video} type="video/mp4" />
					</video>
				))}
			</div>
		</div>
	</div>
</div>

<style>
	.about-nahi {
		background-color: var(--color-black-umber);
		color: var(--color-crystal-cut);
	}

	.section-inner {
		padding-top: var(--space-20);
		padding-bottom: var(--space-20);
		border-top: 1px solid var(--color-rampart);
		@media screen and (min-width: 48rem) {
			padding-top: var(--space-40);
			padding-bottom: var(--space-40);
		}
	}

	h2 {
		margin: var(--space-4) 0;
	}

	.video-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-10);
		margin-top: var(--space-20);
		@media screen and (min-width: 48rem) {
			margin-top: var(--space-40);
		}
	}
	video {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
