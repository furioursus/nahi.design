---
import Caption from "./Caption.astro";
import Description from "./Description.astro";
import LightboxVideo from "./LightboxVideo.astro";
const videos = [
	{ src: "/video/woodworking.mp4", label: "Shaping a piece of wood by hand" },
	{
		src: "/video/pea-puffer.mp4",
		label: "A pea puffer fish drifting through its tank",
	},
	{
		src: "/video/mercer-lab.mp4",
		label: "Nahi’s spouse, Christopher spins around on a swing at Mercer Labs while bathed in light",
	},
	{ src: "/video/dante.mp4", label: "Nahi’s cat Dante" },
];
---

<div class="about-nahi named-hash" id="about-nahi">
	<div class="container">
		<div class="section-inner">
			<Caption>Grounded • Craftsman</Caption>
			<h2 class="h1">Nahi Kennedy&#8209;Nuñez</h2>
			<Description>
				I’m a UX designer with a steady, disciplined approach to my
				craft — equally at home shaping wood by hand, watching my fish
				drift through their little world, getting outvoted by my two
				cats, or losing an afternoon to a good museum.
			</Description>
			<div class="video-grid">
				{
					videos.map(({ src, label }) => (
					<div class="video-pixel">
						<LightboxVideo src={src} label={label} />
					</div>
				))
				}
			</div>
		</div>
	</div>
</div>

<style>
	.about-nahi {
		background-color: var(--color-black-umber);
		color: var(--color-crystal-cut);
	}

	.section-inner {
		padding-top: var(--space-20);
		padding-bottom: var(--space-20);
		border-top: 1px solid var(--color-rampart);
		@media screen and (--bp-md) {
			padding-top: var(--space-40);
			padding-bottom: var(--space-40);
		}
	}

	h2 {
		margin: var(--space-4) 0;
	}

	.video-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-10);
		margin-top: var(--space-20);
		@media screen and (--bp-md) {
			margin-top: var(--space-40);
		}
	}
	/*
	 * LightboxVideo renders its own <lightbox-media>/<video> inside a child component's own style
	 * scope, not this one — see docs/lightbox.md's note on the same issue in TextAndImageBlock.
	 * :global() reaches past that scope boundary deliberately.
	 */
	.video-pixel :global(lightbox-media) {
		display: block;
		width: 100%;
		height: 100%;
	}
	.video-pixel :global(.lightbox-trigger) {
		height: 100%;
	}
	.video-pixel :global(.lightbox-trigger video) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
