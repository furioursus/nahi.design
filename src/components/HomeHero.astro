---
import Browline from "./Browline.astro";
import Description from "./Description.astro";
---

<div class="hero-wrapper">
	<div class="hero container">
		<div class="hero-intro">
			<Browline marginBottom>UX Designer • Facilitator</Browline>
			<h1>Nahi Kennedy&#8209;Nuñez</h1>
			<Description color="var(--color-oubliette)">
				I’m a UX/UI designer who transforms complex systems, from AI platforms
				and data infrastructure to public health, into experiences that are
				intuitive, accessible, and built to last.
			</Description>
		</div>
		<div class="sidebar">
			<ul>
				<li>
					<Browline>Cats</Browline>
					<p>2 stinkers</p>
				</li>
				<li>
					<Browline>Hobbies</Browline>
					<p>Too Many</p>
				</li>
				<li>
					<Browline>Jokes</Browline>
					<p>Awful</p>
				</li>
			</ul>
		</div>
	</div>
</div>

<style>
	.hero-wrapper {
		max-width: 100%;
		padding: var(--space-10) 0;
		@media (--bp-md) {
			padding: var(--space-20) 0;
		}
	}
	.hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		@media (--bp-md) {
			flex-direction: row;
			align-items: stretch;
		}
	}
	.hero-intro {
		flex: 1;
	}
	h1 {
		margin-bottom: var(--space-4);
	}
	.sidebar {
		font-family: var(--text-font-heading);
		font-size: var(--text-xs);
		border-color: var(--color-sunbleached);
		border-width: 1px;
		border-left: none;
		border-top-style: solid;
		padding-top: var(--space-3);
		margin-top: var(--space-3);
		@media (--bp-md) {
			border-top: none;
			border-left: solid 1px var(--color-dovetail);
			padding-top: var(--space-0);
			margin-top: var(--space-0);
			padding-left: var(--space-6);
			margin-left: var(--space-6);
		}
		display: flex;
		align-items: center;
	}
	ul {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-8);
		@media screen and (--bp-md) {
			grid-template-columns: 1fr;
		}
	}
</style>
