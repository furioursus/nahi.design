---
import homepage03 from "@img/homepage-03.png";
import homepage04 from "@img/homepage-04.png";
import logoMark from "@img/logo-mark.svg";
---

<section class="panel" id="hero" data-label="Home">
	<div class="hero-full">
		<div class="hero-inner panel-inner">
			<div class="eyebrow hero-anim d1"><span class="dot"></span>Nahi Kennedy-Nuñez: Product and UX Designer</div>
			<h1 class="hero-name hero-anim d2"><span class="nowrap">People First;</span><br /><span class="hl">Always</span></h1>
			<p class="hero-desc hero-anim d3">
				Hi! I'm Nahi, a product and UX designer working mostly in and around AI and data-heavy tools, where the
				hard part is rarely the interface. It's understanding people, behaviors, and motivations. I promise
				you: the result is always better when you put people first.
			</p>
			<div class="hero-marks hero-anim d4">
				<div
					class="hero-mark hero-mark-photo"
					role="img"
					aria-label="Woodblock print portrait of Nahi Kennedy-Nuñez"
					style={`-webkit-mask-image:url('${homepage03.src}');mask-image:url('${homepage04.src}')`}
				>
				</div>
				<div
					class="hero-mark hero-mark-baybayin"
					role="img"
					aria-label="Nahi, in a hand-drawn Baybayin mark"
					style={`-webkit-mask-image:url('${logoMark.src}');mask-image:url('${logoMark.src}')`}
				>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-full {
		position: relative;
		overflow: hidden;
		width: 100%;
		min-height: 76vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding: 64px 0 56px;
	}
	.hero-inner.panel-inner {
		width: auto;
		max-width: 1040px;
		padding: 0 32px;
		text-align: left;
	}
	.eyebrow {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		gap: 9px;
		font-family: var(--font-mono);
		font-size: 13.5px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--mark);
		margin-bottom: 26px;
	}
	.eyebrow .dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--mark);
		flex-shrink: 0;
	}
	.hero-name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(60.5px, 11.3vw, 181.5px);
		line-height: 0.94;
		letter-spacing: -0.02em;
		margin: 0 0 28px;
		max-width: none;
		text-wrap: balance;
	}
	.hero-name .hl {
		color: var(--mark);
	}
	.hero-name .nowrap {
		white-space: nowrap;
	}
	.hero-desc {
		position: relative;
		z-index: 1;
		font-family: var(--font-body);
		font-size: 17px;
		line-height: 1.75;
		color: var(--ink-mid);
		max-width: 560px;
		margin: 0 0 32px;
	}
	.hero-marks {
		display: flex;
		align-items: flex-start;
		gap: 20px;
	}
	.hero-mark {
		width: 150px;
		height: 158px;
		flex-shrink: 0;
		border-radius: 3px;
		background-image: radial-gradient(circle at 50% 50% in oklch, #f6c445 0%, #ce9a2e 22%, #b33a55 48%, #5c0b22 72%, #5c0b22 100%);
		background-size: 220% 220%;
		background-position: 45% 40%;
		-webkit-mask-position: center;
		mask-position: center;
		-webkit-mask-size: contain;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		transition: background-position 0.3s ease-out;
	}
	@keyframes heroUp {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	.hero-anim {
		animation: heroUp 0.8s var(--ease) both;
	}
	.hero-anim.d1 {
		animation-delay: 0.05s;
	}
	.hero-anim.d2 {
		animation-delay: 0.16s;
	}
	.hero-anim.d3 {
		animation-delay: 0.36s;
	}
	.hero-anim.d4 {
		animation-delay: 0.48s;
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-anim {
			animation: none;
			opacity: 1;
			transform: none;
		}
		.hero-mark {
			transition: none;
		}
	}
	@media (max-width: 600px) {
		.hero-full {
			min-height: 0;
			padding: 44px 0 40px;
		}
		.hero-inner.panel-inner {
			padding: 0 20px;
		}
		.eyebrow {
			margin-bottom: 16px;
		}
		.hero-name {
			font-size: clamp(43px, 17.3vw, 73.5px);
		}
		.hero-desc {
			font-size: 15.5px;
		}
		.hero-mark {
			width: 120px;
			height: 128px;
		}
	}
</style>
