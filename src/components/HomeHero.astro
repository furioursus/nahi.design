---
import homepage04 from "@img/homepage-04.png";
import logoMark from "@img/logo-mark.svg";
---

<section class="panel" id="hero" data-label="Home">
	<div class="hero-full">
		<div class="hero-inner panel-inner">
			<div class="eyebrow hero-anim" data-enter-delay="50"><span class="dot"></span>Nahi Kennedy-Nuñez: Product and UX Designer</div>
			<h1 class="hero-name hero-anim" data-enter-delay="160">I design tools for people working <span class="hl">under pressure.</span></h1>
			<p class="hero-desc hero-anim" data-enter-delay="360">
				Hi, I'm Nahi. Most of my work is in AI and data-heavy products, where someone has twenty minutes to
				find a broken number before an auditor asks about it. The interface is rarely the hard part.
				Understanding what people are actually afraid of getting wrong usually is.
			</p>
			<p class="hero-avail hero-anim" data-enter-delay="480">Open to full-time product design roles on mission-driven teams.</p>
			<div class="hero-marks hero-anim" data-enter-delay="580">
				<div
					class="hero-mark hero-mark-photo"
					role="img"
					aria-label="Woodblock print portrait of Nahi Kennedy-Nuñez"
					style={`-webkit-mask-image:url('${homepage04.src}');mask-image:url('${homepage04.src}')`}
				>
				</div>
				<div
					class="hero-mark hero-mark-baybayin"
					role="img"
					aria-label="Nahi, in a hand-drawn Baybayin mark"
					style={`-webkit-mask-image:url('${logoMark.src}');mask-image:url('${logoMark.src}')`}
				>
				</div>
			</div>
		</div>
	</div>
</section>

<script is:inline>
	// Entrance fade runs on the Web Animations API, not CSS keyframes — see README "Hero entrance".
	(function () {
		if (!Element.prototype.animate || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		var ease = getComputedStyle(document.documentElement).getPropertyValue("--ease").trim() || "ease-out";
		document.querySelectorAll("#hero .hero-anim").forEach(function (el) {
			el.animate(
				[
					{ opacity: 0, transform: "translateY(16px)" },
					{ opacity: 1, transform: "none" },
				],
				{ duration: 800, delay: Number(el.dataset.enterDelay) || 0, easing: ease, fill: "backwards" },
			);
		});
	})();
</script>

<style>
	.hero-full {
		position: relative;
		overflow: hidden;
		width: 100%;
		min-height: 76vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding: 64px 0 56px;
	}
	.hero-inner.panel-inner {
		width: auto;
		max-width: 1040px;
		padding: 0 32px;
		text-align: left;
	}
	.eyebrow {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: flex-start;
		gap: 9px;
		font-family: var(--font-mono);
		font-size: 13.5px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--mark);
		margin-bottom: 26px;
	}
	.eyebrow .dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--mark);
		flex-shrink: 0;
		/* Centers the dot on the first line's cap-height instead of the
		   whole block's, so it doesn't drift to the seam when the eyebrow
		   text wraps to two lines on narrow screens. */
		margin-top: calc((1.7em - 7px) / 2);
	}
	.hero-name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(34px, 5.6vw, 84px);
		line-height: 1.05;
		letter-spacing: -0.01em;
		margin: 0 0 28px;
		max-width: 15ch;
		text-wrap: balance;
	}
	.hero-name .hl {
		color: var(--mark);
	}
	.hero-desc {
		position: relative;
		z-index: 1;
		font-family: var(--font-body);
		font-size: 17px;
		line-height: 1.75;
		color: var(--ink-mid);
		max-width: 560px;
		margin: 0 0 32px;
	}
	.hero-avail {
		position: relative;
		z-index: 1;
		font-family: var(--font-mono);
		font-size: 13px;
		letter-spacing: 0.02em;
		color: var(--ink-soft);
		margin: 0 0 32px;
	}
	.hero-marks {
		display: flex;
		align-items: flex-start;
		gap: 20px;
	}
	.hero-mark {
		width: 150px;
		height: 158px;
		flex-shrink: 0;
		border-radius: 3px;
		background-image: radial-gradient(circle at 50% 50% in oklch, #f6c445 0%, #ce9a2e 22%, #b33a55 48%, #5c0b22 72%, #5c0b22 100%);
		background-size: 220% 220%;
		background-position: 45% 40%;
		-webkit-mask-position: center;
		mask-position: center;
		-webkit-mask-size: contain;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		transition: background-position 0.3s ease-out;
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-mark {
			transition: none;
		}
	}
	@media (max-width: 600px) {
		.hero-full {
			min-height: 0;
			padding: 44px 0 40px;
		}
		.hero-inner.panel-inner {
			/* Without an explicit width here, this flex child (centered on
			   the cross axis of .hero-full's column flex) sizes to its
			   content's shrink-to-fit width instead of the viewport's —
			   wide enough to spill past both edges on narrow screens,
			   which made the padding below look like it wasn't applying
			   at all. */
			width: 100%;
			padding: 0 24px;
		}
		.eyebrow {
			margin-bottom: 16px;
		}
		.hero-name {
			font-size: clamp(30px, 8.7vw, 40px);
			max-width: none;
		}
		.hero-desc {
			font-size: 15.5px;
		}
		.hero-avail {
			font-size: 12px;
		}
		.hero-mark {
			width: 120px;
			height: 128px;
		}
	}
</style>
