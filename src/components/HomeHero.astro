---
import Browline from "./Browline.astro";
---

<div class="hero-wrapper">
    <div class="hero container">
        <div class="hero-intro">
            <Browline marginBottom>UX Designer • Facilitator</Browline>
            <h1>Nahi Kennedy-Nuñez</h1>
            <div class="intro">
                <p>
                    I'm a UX/UI designer who transforms complex systems, from AI
                    platforms and data infrastructure to public health, into
                    experiences that are intuitive, accessible, and built to
                    last.
                </p>
            </div>
        </div>
        <div class="sidebar">
            <ul>
                <li>
                    <Browline>Cats</Browline>
                    <p>2 stinkers</p>
                </li>
                <li>
                    <Browline>Hobbies</Browline>
                    <p>Too Many</p>
                </li>
                <li>
                    <Browline>Jokes</Browline>
                    <p>Awful</p>
                </li>
            </ul>
        </div>
    </div>
</div>

<style>
    .hero-wrapper {
        max-width: 100%;
        padding: var(--space-10) 0;
        @media (min-width: 48rem) {
            padding: var(--space-20) 0;
        }
    }
    .hero {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        @media (min-width: 48rem) {
            flex-direction: row;
            align-items: stretch;
        }
    }
    .hero-intro {
        flex: 1;
    }
    h1 {
        margin-bottom: var(--space-4);
    }
    .intro {
        font-family: var(--text-font-heading);
        font-size: var(--text-sm);
        color: var(--oubliette);
        letter-spacing: var(--letter-spacing-normal);
        max-width: 35rem;
    }
    .sidebar {
        font-family: var(--text-font-heading);
        font-size: var(--text-xs);
        border-left: solid 1px var(--dovetail);
        min-width: 104px;
        padding-left: var(--space-6);
        display: flex;
        align-items: center;
    }
    ul {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }
</style>
