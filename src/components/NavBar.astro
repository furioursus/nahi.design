---
const isHome = Astro.url.pathname === "/";
---

<nav class="navbar" aria-labelledby="mainmenulabel">
	<h2 class="visually-hidden" id="mainmenulabel">Main Menu</h2>
	<div class="nav navbar-nav menu container">
		<a class="logo" href="/">
			<img
				src="/img/nav-logo.png"
				srcset="/img/nav-logo.png 1x, /img/nav-logo@2x.png 2x, /img/nav-logo@3x.png 3x, /img/nav-logo@4x.png 4x"
				alt=""
				width="112"
				height="24"
			/>
			<span class="visually-hidden">Home</span>
		</a>
		<div class="nav-items">
			{isHome ? (
				<>
					<a class="nav-item" href="#case-studies" data-section="case-studies">Case Studies</a>
					<a class="nav-item" href="#about-nahi" data-section="about-nahi">About</a>
					<a class="nav-item" href="#contact" data-section="contact">Contact</a>
				</>
			) : (
				<>
					<a class="nav-item active" href="/#case-studies">Case Studies</a>
						<a class="nav-item" href="/#about-nahi">About</a>
						<a class="nav-item" href="/#contact">Contact</a>
				</>
			)}
		</div>
	</div>
</nav>

{isHome && (
	<script>
		function initNav() {
			const navItems = document.querySelectorAll<HTMLAnchorElement>(".nav-item[data-section]");
			const sections = Array.from(navItems).map((link) => {
				const id = link.dataset.section!;
				return { link, section: document.getElementById(id) };
			});

			function setActiveFromHash(hash: string) {
				const id = hash.replace("#", "");
				for (const { link } of sections) {
					link.classList.toggle("active", link.dataset.section === id);
				}
			}

			for (const { link } of sections) {
				link.addEventListener("click", () => setActiveFromHash(link.hash));
			}

			// Set initial state from hash if present
			if (location.hash) {
				setActiveFromHash(location.hash);
			}

			// Logo scrolls to top when already on the home page
			document.querySelector(".logo")?.addEventListener("click", (e) => {
				if (location.pathname !== "/") return;
				e.preventDefault();
				window.scrollTo({ top: 0, behavior: "smooth" });
				history.pushState("", "", "/");
				for (const { link } of sections) {
					link.classList.remove("active");
				}
			});
		}

		document.addEventListener("astro:page-load", initNav);
	</script>
)}

<style>
	.navbar {
		background-color: var(--black-umber);
		font-family: var(--text-font-heading);
		font-size: var(--text-xs);
		padding: var(--space-8) 0;
		position: sticky;
		top: 0;
		z-index: 100;
	}
	.nav {
		display: flex;
		flex-direction: column;
		gap: var(--space-7);
		@media (min-width: 30rem) {
			flex-direction: row;
			justify-content: space-between;
		}
	}

	.logo {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.nav-items {
		display: flex;
		gap: var(--space-7);
	}

	.nav-item {
		color: var(--rampart);
		text-decoration: none;
		position: relative;
		&:hover,
		&.active {
			color: var(--crystal-cut);
		}
		&.active {
			&::after {
				content: "";
				position: absolute;
				bottom: -2px;
				left: 0;
				width: 100%;
				height: 1px;
				background-color: var(--crystal-cut);
			}
		}
	}
</style>
