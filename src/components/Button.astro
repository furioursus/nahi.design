---
interface Props {
	href: string;
	class?: string;
	obfuscate?: boolean;
}

const { href, class: className, obfuscate } = Astro.props;
---

<a
	class:list={["button", { className }]}
	data-obfuscation={obfuscate}
	href={href}
>
	<slot />
</a>

<style>
	.button {
		background-color: var(--color-crystal-cut);
		border: 1px solid var(--color-deep-nurse);
		border-radius: var(--rounded-edge);
		color: var(--color-deep-nurse);
		font-family: var(--text-font-heading);
		text-decoration: none;
		display: inline-flex;
		padding: var(--space-2) var(--space-5);
		box-shadow: none;
		border-radius: var(--rounded-edge);

		transition:
			box-shadow 0.2s ease,
			background-color 0.2s ease;

		&:hover {
			background-color: var(--color-sea-white);
			box-shadow: 0px 2px 6px 6px #1c191608;
		}
	}
</style>
