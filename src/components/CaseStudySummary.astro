---
import SectionHeading from "@components/SectionHeading.astro";
import Description from "@components/Description.astro";

interface Props {
	summaryDetail: string;
	theAsk: string;
	theApproach: string;
	theOutcome: string;
}

const { summaryDetail, theAsk, theApproach, theOutcome } = Astro.props;
---

<div class="case-study-summary">
	<SectionHeading title="Summary." number={1} />
	<Description
		fontFamily="var(--text-font-body)"
		size="var(--text-base)"
		color="var(--color-black-umber)"
		margin="var(--space-4) var(--space-0) var(--space-16)"
	>
		{summaryDetail}
	</Description>
	<ul class="ask-approach-outcome-grid inner-padding">
		<li class="ask-approach-outcome-item">
			<h3>The Ask</h3>
			<p>{theAsk}</p>
		</li>
		<div class="ask-approach-outcome-item">
			<h3>The Approach</h3>
			<p>{theApproach}</p>
		</div>
		<div class="ask-approach-outcome-item">
			<h3>The Outcome</h3>
			<p>{theOutcome}</p>
		</div>
	</ul>
</div>

<style>
	.case-study-summary {
		padding-top: var(--space-20);
		padding-bottom: var(--space-20);
	}

	.ask-approach-outcome-grid {
		display: grid;
		gap: var(--space-3);
		@media screen and (min-width: 48rem) {
			grid-template-columns: repeat(3, 19.375rem);
		}
	}

	.ask-approach-outcome-item {
		border-top: solid 1px var(--color-rampart);
		padding-top: var(--space-4);
		h3 {
			font-family: var(--text-font-heading);
			font-size: var(--text-2xs);
			color: var(--color-dovetail);
			letter-spacing: var(--letter-spacing-loosest);
			line-height: var(--line-height-normal);
			margin-bottom: var(--space-2);
		}
		p {
			font-family: var(--text-font-body);
			font-size: var(--text-sm);
			line-height: var(--line-height-normal);
			color: var(--color-oubliette);
		}
	}
</style>
