---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface VideoSource {
	src: string;
	media?: string;
}

interface VideoProps {
	poster: string;
	sources: VideoSource[];
}

interface Props {
	src?: ImageMetadata;
	video?: VideoProps;
	alt: string;
	figNum: string;
	lead: string;
	wide?: boolean;
	tall?: boolean;
	bare?: boolean;
	fit?: "contain" | "center";
	deck?: boolean;
	deckLabel?: string;
	placeholderLabel?: string;
}

const { src, video, alt, figNum, lead, wide, tall, bare, fit, deck, deckLabel, placeholderLabel } =
	Astro.props;
---

<figure
	class:list={["rev", { wide }]}
	data-deck={deck ? "image" : undefined}
	data-deck-label={deckLabel}
	data-fit={fit}
>
	<div class:list={["frame", { tall, "has-img": src || video, bare: bare && src }]}>
		{
			src ? (
				<Image src={src} alt={alt} />
			) : video ? (
				<video muted loop playsinline preload="metadata" data-ambient poster={video.poster} aria-label={alt}>
					{video.sources.map((s) => (
						<source src={s.src} media={s.media} type="video/mp4" />
					))}
				</video>
			) : (
				<div class="frame-tag">
					<b>{placeholderLabel}</b>
					{alt}
				</div>
			)
		}
	</div>
	<figcaption>
		<span class="fn">{figNum}</span>
		<span><strong class="fig-lead">{lead}</strong><slot /></span>
	</figcaption>
</figure>
