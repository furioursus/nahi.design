---
// Shell for flow-mode pages: pinned open, scrolling body, pinned close — see docs/scroll-flow.md.
interface Props {
	closeSurface?: "raised" | "soft" | "ink";
}

const { closeSurface = "raised" } = Astro.props;
---

<section class="panel page-open">
	<div class="panel-inner wrap">
		<slot name="hero" />
	</div>
</section>

<div class="page-body-shadow">
	<div class="page-body">
		<div class="wrap">
			<slot />
		</div>
	</div>
</div>

<section class="panel page-close" data-surface={closeSurface}>
	<div class="panel-inner wrap">
		<slot name="close" />
	</div>
</section>
