---
import type { ImageMetadata } from "astro";
import LightboxImage from "@components/LightboxImage.astro";

interface Props {
	browline: string;
	image: ImageMetadata;
	imagesIsTransparent?: boolean;
	imageAlt: string;
	imageRatio?: "16/9" | "4/3" | "1/1";
	imagePosition?: string;
}

const {
	browline,
	image,
	imagesIsTransparent,
	imageAlt,
	imageRatio,
	imagePosition,
} = Astro.props;
---

<div class="text-and-image-block inner-padding">
	<div class="text-wrapper">
		<div class="text">
			<p class="text-title eyebrow">{browline}</p>
			<div class="image-block-description">
				<slot />
			</div>
		</div>
	</div>
	<div class="image-wrapper">
		<div
			class:list={[
				"image",
				{ "transparent-png": imagesIsTransparent, "has-ratio": imageRatio },
			]}
			style={{ "--image-ratio": imageRatio, "--image-position": imagePosition }}
		>
			<LightboxImage src={image} alt={imageAlt} thumbHeight="none" />
		</div>
	</div>
</div>

<style>
	.text-and-image-block {
		margin-top: var(--space-16);
		display: grid;
		gap: var(--space-3);
		grid-template-areas: "image" "text";
		@media screen and (--bp-md) {
			gap: var(--space-6);
			grid-template-columns: repeat(2, 1fr);
			grid-template-areas: "text image image";
		}
		@media screen and (--bp-lg) {
			grid-template-columns: repeat(3, 1fr);
			grid-template-areas: "text image image";
		}
	}
	.text-wrapper {
		grid-area: text;
		padding: var(--space-2) var(--space-0);
	}
	.text {
		@media screen and (--bp-md) {
			padding-right: var(--space-6);
			border-right: 1px solid var(--color-rampart);
		}
	}
	.image-wrapper {
		grid-area: image;
	}
	.text-title {
		line-height: var(--line-height-none);
		margin-bottom: var(--space-1);
	}
	.image-block-description {
		font-size: var(--text-base);
		line-height: var(--line-height-relaxed);

		> p {
			margin-top: var(--space-6);
			+ ul {
				margin-top: 0;
			}
			&:first-child {
				margin-top: 0;
			}
		}
		ul {
			list-style: disc;
			padding-left: var(--space-6);
			margin-bottom: var(--space-6);
			&:last-child {
				margin-bottom: 0;
			}
		}
	}
	.image {
		overflow: hidden;
		border-radius: var(--rounded-edge-heavy);
		box-shadow: var(--space-0) var(--space-1) var(--space-1) rgba(0, 0, 0, 0.1);
		&.has-ratio {
			aspect-ratio: var(--image-ratio);
		}
		&.transparent-png {
			box-shadow: none;
			border-radius: 0;
			overflow: visible;
		}
	}
	/*
	 * LightboxImage renders its own <img> (and everything around it) inside a child component's
	 * own style scope, not this one — a plain `.image img` selector here silently never matches
	 * it. :global() reaches past that scope boundary deliberately; `.image`/`.image.has-ratio`/
	 * `.image.transparent-png` stay scoped normally since those are this component's own divs.
	 */
	.image :global(lightbox-image) {
		display: block;
		width: 100%;
		/* No-op unless an ancestor has a definite height (the has-ratio case, below) — percentage
		   height against an auto-height ancestor just resolves to auto, so this is harmless for
		   the default, unconstrained case. */
		height: 100%;
	}
	.image.has-ratio :global(.lightbox-trigger) {
		height: 100%;
	}
	.image.has-ratio :global(.lightbox-trigger img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--image-position, center);
	}
	.image.transparent-png :global(.lightbox-trigger img) {
		border-radius: 0;
		filter: drop-shadow(var(--space-0) var(--space-1) var(--space-1) rgba(0, 0, 0, 0.1));
	}
</style>
