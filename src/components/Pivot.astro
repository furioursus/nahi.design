---
interface Props {
	heading: string;
	label?: string;
}

const { heading, label = "What changed" } = Astro.props;
---

<div class="pivot">
	<div class="pivot-k"><span class="dot"></span>{label}</div>
	<div class="pivot-h deck-stat" data-deck-eyebrow={label}>{heading}</div>
	<div class="pivot-b"><slot /></div>
</div>
