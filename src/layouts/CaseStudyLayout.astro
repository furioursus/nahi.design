---
import BaseLayout from "./BaseLayout.astro";
import CaseStudyTopbar from "@components/CaseStudyTopbar.astro";
import DeckLightbox from "@components/DeckLightbox.astro";
import PageFlow from "@components/PageFlow.astro";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description} showNav={false} scrollMode="flow" ogType="article">
	<a class="sr-only" href="#main">Skip to case study</a>
	<CaseStudyTopbar title={title} />
	<main id="main">
		<PageFlow>
			<Fragment slot="hero"><slot name="hero" /></Fragment>
			<slot />
			<Fragment slot="close"><slot name="close" /></Fragment>
		</PageFlow>
	</main>
	<DeckLightbox title={title} />
</BaseLayout>

<script>
	/* Reading progress + section wayfinding label in the topbar. */
	(function () {
		const bar = document.querySelector(".topbar") as HTMLElement | null,
			prog = document.getElementById("progBar"),
			secEl = document.getElementById("topSec"),
			secT = document.getElementById("topSecT"),
			main = document.getElementById("main"),
			nextBlock = document.querySelector(".next");
		if (!bar || !prog || !secEl || !secT || !main) return;
		const RM = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const marks: { el: Element; label: string }[] = [{ el: main, label: "Overview" }];
		Array.from(document.querySelectorAll("main section[id]")).forEach((s) => {
			const n = s.querySelector(".sec-num"),
				h = s.querySelector("h2");
			marks.push({ el: s, label: (n ? n.textContent!.trim() + " · " : "") + (h ? h.textContent!.trim() : s.id) });
		});
		let shown = "Overview",
			raf = 0;
		function topOf(el: Element) {
			return el.getBoundingClientRect().top + window.scrollY;
		}
		function paint() {
			const start = topOf(main!),
				bar2 = bar!;
			let end = nextBlock ? topOf(nextBlock) : document.body.scrollHeight;
			/* The bar must be able to fill. A short final section can put the end
			   marker below the furthest point the page can scroll to, so cap the
			   end at what's actually reachable: when the reader hits the bottom,
			   the bar is full. */
			const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
			end = Math.min(end, maxScroll + bar2.offsetHeight);
			if (end <= start) end = start + 1;
			const p = (window.scrollY + bar2.offsetHeight - start) / (end - start);
			(prog as HTMLElement).style.transform = "scaleX(" + Math.min(1, Math.max(0, p)) + ")";
			const edge = bar2.offsetHeight + 28;
			let cur = marks[0];
			const laid = topOf(marks[marks.length - 1].el) > 0;
			if (laid && window.scrollY > 0) {
				marks.forEach((m) => {
					if (topOf(m.el) <= window.scrollY + edge) cur = m;
				});
				/* Same fix for the label: at the bottom of the page, the last section
				   is the current one even if its heading never crossed the topbar. */
				if (window.scrollY >= maxScroll - 2) cur = marks[marks.length - 1];
			} else if (!laid) return;
			if (cur.label !== shown) {
				shown = cur.label;
				if (RM) {
					secT!.textContent = shown;
					return;
				}
				secEl!.classList.add("swap");
				setTimeout(() => {
					secT!.textContent = shown;
					secEl!.classList.remove("swap");
				}, 150);
			}
		}
		function onScroll() {
			if (raf) cancelAnimationFrame(raf);
			raf = requestAnimationFrame(() => {
				raf = 0;
				paint();
			});
		}
		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", onScroll);
		window.addEventListener("load", paint);
		if (document.fonts && document.fonts.ready) document.fonts.ready.then(paint);
		paint();
	})();
</script>
