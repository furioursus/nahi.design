---
import type { CaseStudyMeta } from "@data/case-studies";
import BaseLayout from "./BaseLayout.astro";
import HeroImage from "@components/HeroImage.astro";
import Browline from "@components/Browline.astro";
import Description from "@components/Description.astro";
import CaseStudySummary from "@components/CaseStudySummary.astro";

interface Props extends CaseStudyMeta {
	compactContact?: boolean;
}

const { compactContact = true, ...meta } = Astro.props;
const {
	id,
	title,
	status,
	services,
	tags,
	summary,
	thumbSummary,
	heroImage,
	heroImageAlt,
	summaryDetail,
	theAsk,
	theApproach,
	theOutcome,
} = meta;
---

<BaseLayout
	title={`${title} — Nahi Kennedy-Nuñez`}
	description={thumbSummary}
	compactContact={compactContact}
>
	<div class="container">
		<header class="case-study-hero">
			<div class="case-study-intro">
				<Browline marginBottom>
					{
						tags.map((item, idx) => (
							<span class="info-item">
								{item}
								{idx < tags.length - 1 && " • "}
							</span>
						))
					}
				</Browline>
				<h1 class="title">{title}</h1>
				<Description
					fontFamily="var(--text-font-body)"
					size="var(--text-base)"
					color="var(--color-black-umber)"
				>
					{summary}
				</Description>
			</div>
			<div class="sidebar">
				<ul>
					<li>
						<Browline>Status</Browline>
						<p>{status}</p>
					</li>
					<li>
						<Browline>Services</Browline>
						<ul class="services">
							{services.map((item) => <li class="service-item">{item}</li>)}
						</ul>
					</li>
				</ul>
			</div>
		</header>

		<HeroImage
			image={heroImage}
			alt={heroImageAlt}
			transitionName={`hero-image-${id}`}
		/>

		<article class="case-study-body">
			<CaseStudySummary
				summaryDetail={summaryDetail}
				theAsk={theAsk}
				theApproach={theApproach}
				theOutcome={theOutcome}
			/>
			<slot />
		</article>
	</div>
</BaseLayout>

<style>
	.case-study-hero {
		padding-top: var(--space-20);
		padding-bottom: var(--space-20);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		@media (min-width: 48rem) {
			flex-direction: row;
			align-items: stretch;
		}
	}
	.case-study-intro {
		flex: 1;
	}

	.title {
		font-size: var(--text-3xl);
		margin-bottom: var(--space-4);
	}

	.sidebar {
		font-family: var(--text-font-heading);
		font-size: var(--text-xs);
		border-left: solid 1px var(--color-dovetail);
		min-width: 104px;
		padding-left: var(--space-6);
		display: flex;
		align-items: center;
	}
	ul {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		&.services {
			gap: 0;
		}
	}
</style>
