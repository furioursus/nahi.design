---
import type { CaseStudyMeta } from "@data/case-studies";
import BaseLayout from "./BaseLayout.astro";
import HeroImage from "@components/HeroImage.astro";
import Browline from "@components/Browline.astro";
import Description from "@components/Description.astro";
import CaseStudySummary from "@components/CaseStudySummary.astro";

interface Props extends CaseStudyMeta {
	nextUrl?: string;
	nextUrlText?: string;
}

const { nextUrl, nextUrlText, ...meta } = Astro.props;
const {
	id,
	title,
	status,
	services,
	tags,
	summary,
	thumbSummary,
	heroImage,
	heroImageAlt,
	summaryDetail,
	theAsk,
	theApproach,
	theOutcome,
} = meta;
---

<BaseLayout title={`Case Study: ${title}`} description={thumbSummary}>
	<div class="container">
		<header class="case-study-hero">
			<div class="case-study-intro">
				<Browline marginBottom>
					{
						tags.map((item, idx) => (
							<span class="info-item">
								{item}
								{idx < tags.length - 1 && " • "}
							</span>
						))
					}
				</Browline>
				<h1 class="title">{title}</h1>
				<Description variant="case-study" margin="var(--space-0)">
					{summary}
				</Description>
			</div>
			<div class="sidebar">
				<ul>
					<li class="status">
						<Browline>Status</Browline>
						<p>{status}</p>
					</li>
					<li class="services">
						<Browline>Services</Browline>
						<ul class="service-list">
							{services.map((item) => <li class="service-item">{item}</li>)}
						</ul>
					</li>
				</ul>
			</div>
		</header>

		<HeroImage
			image={heroImage}
			alt={heroImageAlt}
		/>

		<article class="case-study-body">
			<CaseStudySummary
				summaryDetail={summaryDetail}
				theAsk={theAsk}
				theApproach={theApproach}
				theOutcome={theOutcome}
			/>
			<slot name="after-summary" />
			<slot />
		</article>
		<footer class="full-width-breakout">
			<div class="container">
				<div class="footer-links">
					<div class="go-to-next">
						{nextUrl && nextUrlText && <a href={nextUrl}>{nextUrlText} →</a>}
					</div>
					<div class="contact-links">
						<a href="mailto:hello@nahi.design" data-obfuscation>hello@nahi.design</a>
						<a href="https://www.linkedin.com/in/nahidesign/">LinkedIn</a>
					</div>
				</div>
			</div>
		</footer>
	</div>
</BaseLayout>

<style>
	.case-study-hero {
		padding-top: var(--space-20);
		padding-bottom: var(--space-20);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		@media (min-width: 48rem) {
			flex-direction: row;
			align-items: stretch;
		}
	}
	.case-study-intro {
		flex: 1;
	}

	.title {
		font-size: var(--text-3xl);
		margin-bottom: var(--space-4);
	}

	.sidebar {
		font-family: var(--text-font-heading);
		font-size: var(--text-xs);
		border-color: var(--color-sunbleached);
		border-width: 1px;
		border-left: none;
		border-top-style: solid;
		padding-top: var(--space-4);
		margin-top: var(--space-4);
		width: 100%;
		@media (min-width: 48rem) {
			max-width: var(--space-24);
			border-top: none;
			border-left: solid 1px var(--color-dovetail);
			padding-top: var(--space-0);
			margin-top: var(--space-0);
			padding-left: var(--space-6);
			margin-left: var(--space-6);
		}
		display: flex;
		align-items: center;
	}
	ul {
		display: grid;
		grid-template-columns: repeat(1, 1fr);
		gap: var(--space-2);
		@media screen and (min-width: 48rem) {
			grid-template-columns: 1fr;
		}
		&.service-list {
			gap: 0;
			display: flex;
			flex-direction: row;
			gap: var(--space-0) var(--space-4);
			flex-wrap: wrap;
		}
	}
	footer {
		background-color: var(--color-black-umber);
		color: var(--color-crystal-cut);
		font-family: var(--text-font-heading);
	}
	.footer-links {
		padding: var(--space-20) var(--space-0);
		display: flex;
		gap: var(--space-8);
		a {
			color: var(--color-crystal-cut);
			text-decoration: none;
		}
		.contact-links {
			font-size: var(--text-xs);
			display: flex;
			gap: 0 var(--space-4);
			align-items: end;
			justify-content: center;
			flex: 1;
			text-align: right;
			flex-direction: column;
			@media screen and (min-width: 48rem) {
				flex-direction: row;
				justify-content: end;
			}

			a {
				color: var(--color-rampart);
			}
		}
	}
</style>
