---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";

interface Props {
    entry: CollectionEntry<"case-studies">;
}

const { entry } = Astro.props;
const { title, status, services, tags, summary } = entry.data;
---

<BaseLayout title={`${title} — Nahi Kennedy-Nuñez`} description={summary}>
    <div class="container">
        <header class="case-study-header">
            <div class="meta">
                <span class="status">{status}</span>
                <ul class="services" aria-label="Services">
                    {services.map((s) => <li>{s}</li>)}
                </ul>
                <ul class="tags" aria-label="Tags">
                    {tags.map((t) => <li>{t}</li>)}
                </ul>
            </div>

            <h1 class="title">{title}</h1>
            <p class="summary">{summary}</p>
        </header>

        <article class="case-study-body">
            <slot />
        </article>
    </div>
</BaseLayout>

<style>
    .case-study-header {
        padding-top: var(--space-10);
        margin-top: var(--space-10);
        border-top: 1px solid var(--dovetail);
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-4);
        font-family: var(--text-font-heading);
        font-size: var(--text-2xs);
        font-weight: var(--weight-medium);
        letter-spacing: var(--letter-spacing-loose);
        color: var(--oubliette);
        margin-bottom: var(--space-6);
    }

    .status {
        color: var(--dovetail);
    }

    .services,
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .tags li {
        padding: var(--space-1) var(--space-3);
        border: 1px solid var(--bowstring);
        border-radius: 9999px;
    }

    .title {
        font-family: var(--text-font-heading);
        font-size: var(--text-4xl);
        font-weight: var(--weight-regular);
        line-height: var(--leading-snug);
        letter-spacing: var(--letter-spacing-tight);
        margin-bottom: var(--space-6);
    }

    .summary {
        font-size: var(--text-lg);
        line-height: var(--leading-normal);
        color: var(--black-umber);
        max-width: 72ch;
        margin-bottom: var(--space-10);
    }

    .hero-image-wrapper {
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: var(--rounded-edge);
        border: 1px solid var(--bowstring);
        background-color: var(--grey-white);
        margin-bottom: var(--space-16);
    }

    .hero-image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .case-study-body {
        max-width: 72ch;
        margin: 0 auto var(--space-20);

        :global(h2) {
            font-family: var(--text-font-heading);
            font-size: var(--text-2xl);
            font-weight: var(--weight-regular);
            letter-spacing: var(--letter-spacing-tight);
            margin-top: var(--space-12);
            margin-bottom: var(--space-4);
        }

        :global(h3) {
            font-family: var(--text-font-heading);
            font-size: var(--text-xl);
            font-weight: var(--weight-regular);
            letter-spacing: var(--letter-spacing-tight);
            margin-top: var(--space-8);
            margin-bottom: var(--space-3);
        }

        :global(p) {
            font-size: var(--text-base);
            line-height: var(--leading-normal);
            color: var(--black-umber);
            margin-bottom: var(--space-4);
        }

        :global(ul),
        :global(ol) {
            padding-left: var(--space-6);
            margin-bottom: var(--space-4);
        }

        :global(li) {
            line-height: var(--leading-normal);
            margin-bottom: var(--space-2);
        }

        :global(img) {
            width: 100%;
            border-radius: var(--rounded-edge);
            border: 1px solid var(--bowstring);
            margin: var(--space-8) 0;
        }
    }
</style>
