---
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageFlow from "@components/PageFlow.astro";
import Contact from "@components/Contact.astro";
import about01 from "@img/about-01.webp";

const hobbies = [
	{
		title: "Woodworking",
		blurb: "There is no undo button. A cut you rush is a cut you live with, which is a good argument for slowing down right before the step you can't take back.",
		alt: "Shaping a piece of wood by hand",
		src: "/video/woodworking.mp4",
	},
	{
		title: "Fish keeping",
		blurb: "A tank punishes overcorrection. Most days the right move is to check one number, then leave it alone and let the system settle.",
		alt: "A pea puffer fish drifting through its tank",
		src: "/video/pea-puffer.mp4",
	},
	{
		title: "Museums",
		blurb: "A good exhibit takes a room full of objects and tells you where to look first. That is most of my job, done well by someone else.",
		alt: "A visit to the Mercer Museum, caught mid-motion on a swing bathed in light",
		src: "/video/mercer-lab.mp4",
	},
	{
		title: "Cats",
		blurb: "Two of them, Dante here included. Neither has ever cared about a deadline, which keeps mine in proportion.",
		alt: "Nahi's cat Dante",
		src: "/video/dante.mp4",
	},
];
---

<BaseLayout title="About" description="A few other things about Nahi Kennedy-Nuñez.">
	<main id="main">
		<PageFlow>
			<Fragment slot="hero">
				<div class="hero">
					<div class="eyebrow"><span class="dot"></span><span>About · Open to full-time roles</span></div>
					<h1>I design tools for people <span class="hl">working under pressure.</span></h1>
					<p class="lede measure">
						The people I design for are usually having a hard day. An outage at two in the morning, a diagnosis they are trying to make sense of, a dataset they have ten minutes to explain to a room that has already made up its mind.
					</p>
				</div>
			</Fragment>

			<div class="about">
				<Image class="about-photo" src={about01} alt="Nahi Kennedy-Nuñez" />
				<div class="about-text">
					<p><strong>Pressure narrows what a person can hold in their head.</strong> So the hard part of my work is rarely the interface. It is deciding what the interface is allowed to leave out, and being able to defend that call to the people who have to live with it.</p>
					<p>I'm a product and UX designer in New York, working mostly in AI and data-heavy tools. I've done that at IBM, at Pachyderm and then HPE after the acquisition, and for a public health nonprofit in Arizona where the users were people looking for HIV care. Right now I'm looking for a full-time seat on a mission-driven team.</p>
				</div>
			</div>

			<div class="facts">
				<div class="fact"><div class="fact-k">Based in</div><div class="fact-v">New York</div></div>
				<div class="fact"><div class="fact-k">Cats</div><div class="fact-v">2 stinkers</div></div>
				<div class="fact"><div class="fact-k">Jokes</div><div class="fact-v">Awful</div></div>
			</div>

			<section id="outside-of-design">
				<div class="sec-head"><h2>Where the calm comes from</h2><span class="sec-rule"></span></div>
				<p class="sec-intro measure">
					Everything I do away from a screen is slow, and none of it can be rushed without consequences. That is not an accident. It is where I learned what it costs to hurry someone, and how much of a job can be quietly taken off their hands.
				</p>
				<div class="hobbies">
					{
						hobbies.map((hobby) => (
							<div class="hobby">
								<div class="hobby-video">
									<video autoplay muted loop playsinline data-ambient aria-label={hobby.alt}>
										<source src={hobby.src} type="video/mp4" />
									</video>
								</div>
								<div class="hobby-body">
									<div class="hobby-title">{hobby.title}</div>
									<div class="hobby-blurb">{hobby.blurb}</div>
								</div>
							</div>
						))
					}
				</div>
			</section>

			<Fragment slot="close">
				<Contact />
				<div class="closing"><a href="/#work">← Back to the case studies</a></div>
			</Fragment>
		</PageFlow>
	</main>
</BaseLayout>

<style>
	.hero {
		padding: 64px 0 0;
	}
	h1 {
		font-size: clamp(39px, 6vw, 65px);
		font-weight: 600;
		line-height: 1.08;
		letter-spacing: -0.02em;
		margin: 0 0 24px;
		text-wrap: balance;
		max-width: 15ch;
	}
	.lede {
		font-size: 20.5px;
		line-height: 1.75;
		color: var(--ink-mid);
		text-wrap: pretty;
		max-width: var(--measure);
	}
	.about {
		display: flex;
		align-items: flex-start;
		gap: 30px;
		padding: 52px 0 32px;
		margin-bottom: 8px;
	}
	.about-photo {
		width: 100px;
		height: 100px;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
		border: 1px solid var(--rule);
	}
	.about-text {
		font-size: 17.5px;
		line-height: 1.85;
		color: var(--ink-mid);
		max-width: 560px;
	}
	.about-text p {
		margin: 0 0 16px;
	}
	.about-text p:last-child {
		margin-bottom: 0;
	}
	.about-text strong {
		color: var(--ink);
		font-weight: 600;
	}
	.sec-intro {
		font-size: 17.5px;
		line-height: 1.8;
		color: var(--ink-mid);
		margin: 0 0 30px;
		text-wrap: pretty;
	}
	.facts {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1px;
		background: var(--rule);
		border: 1px solid var(--rule);
		border-radius: 2px;
		overflow: hidden;
		margin-bottom: 64px;
	}
	.fact {
		background: var(--surface);
		padding: 18px 20px;
	}
	.fact-k {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-soft);
		margin-bottom: 6px;
	}
	.fact-v {
		font-family: var(--font-display);
		font-size: 21.5px;
		font-weight: 600;
		color: var(--mark);
	}
	.hobbies {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 26px;
	}
	.hobby {
		display: block;
		background: var(--surface);
		border: 1px solid var(--rule);
		border-radius: 3px;
		overflow: hidden;
		color: inherit;
	}
	.hobby-video {
		aspect-ratio: 5 / 6;
		overflow: hidden;
		background:
			repeating-linear-gradient(135deg, color-mix(in srgb, var(--ink) 5%, transparent) 0 1px, transparent 1px 13px),
			var(--surface);
		border-bottom: 1px solid var(--rule);
	}
	.hobby-video video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.hobby-body {
		padding: 22px 24px 24px;
	}
	.hobby-title {
		font-family: var(--font-display);
		font-size: 19.5px;
		font-weight: 500;
		color: var(--ink);
		margin-bottom: 9px;
		letter-spacing: -0.01em;
	}
	.hobby-blurb {
		font-size: 15.5px;
		line-height: 1.75;
		color: var(--ink-mid);
	}
	@media (max-width: 820px) {
		.hobbies {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 600px) {
		h1 {
			font-size: 34.5px;
		}
		.lede {
			font-size: 18px;
		}
		.hero {
			padding: 32px 0 0;
		}
		.about {
			flex-direction: column;
			align-items: flex-start;
			gap: 18px;
			padding: 36px 0 32px;
		}
		.facts {
			grid-template-columns: 1fr;
		}
	}
</style>
