---
import BaseLayout from "@layouts/BaseLayout.astro";
import HomeHero from "@components/HomeHero.astro";
import CaseStudies from "@components/CaseStudies.astro";
import Contact from "@components/Contact.astro";
---

<BaseLayout
	title="Home"
	description="Nahi Kennedy-Nuñez designs AI and data-heavy products for people working under pressure. Case studies from IBM, HPE, QuantaLyric, and HIVAZ.org."
	scrollMode="paged"
>
	<main id="main">
		<HomeHero />
		<CaseStudies />
		<section class="panel" id="contact" data-label="Get in touch" data-surface="ink">
			<div class="panel-inner wrap">
				<Contact />
			</div>
		</section>
	</main>
</BaseLayout>
