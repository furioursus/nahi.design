---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageFlow from "@components/PageFlow.astro";
import Contact from "@components/Contact.astro";
import { competencies, experience, education, certifications } from "@data/cv";
---

<BaseLayout title="CV" description="Nahi Kennedy-Nuñez's CV — Senior UX designer with 8+ years leading end-to-end product design for enterprise B2B SaaS, data-intensive platforms, and AI/ML products.">
	<main id="main">
		<PageFlow>
			<Fragment slot="hero">
				<div class="hero">
					<div class="eyebrow"><span class="dot"></span><span>Senior Product &amp; UX Designer · Open to full-time roles</span></div>
					<h1>Nahi Kennedy-Nuñez</h1>
					<p class="lede measure">
						I design tools for people working under pressure: engineers mid-outage, analysts with ten
						minutes to explain a dataset, patients looking for care. Eight years of end-to-end product
						design in enterprise and data-heavy AI products, at IBM, Pachyderm, HPE, and a CDC-funded
						health nonprofit. Red Dot Award winner. The IBM work is still in production six years on.
					</p>

					<div class="contact-row">
						<a href="tel:+14157129477">(415) 712-9477</a>
						<span class="sep">·</span>
						<a href="mailto:hello@nahi.design" data-obfuscation>hello@nahi.design</a>
						<span class="sep">·</span>
						<a href="https://www.linkedin.com/in/nahidesign/" target="_blank" rel="noopener">linkedin.com/in/nahidesign</a>
						<span class="sep">·</span>
						<a href="https://www.nahi.design/" target="_blank" rel="noopener">nahi.design</a>
						<span class="sep">·</span>
						<span>New York City Metro Area</span>
					</div>

					<div class="hero-cta">
						<a class="btn btn-primary" href="mailto:hello@nahi.design" data-obfuscation>Email me</a>
						<a class="btn btn-ghost" href="/nahi-kennedy-nunez-cv.pdf" target="_blank" rel="noopener">Open as PDF ↗</a>
					</div>
				</div>
			</Fragment>

			<section>
				<div class="sec-head"><h2>Core competencies</h2><span class="sec-rule"></span></div>
				<div class="chips">
					{competencies.map((c) => <span class="chip">{c}</span>)}
				</div>
			</section>

			<section>
				<div class="sec-head"><h2>Experience</h2><span class="sec-rule"></span></div>
				<div class="xp">
					{
						experience.map((item) => (
							<div class="xp-item">
								<div class="xp-head">
									<div class="xp-role">
										{item.role} {item.org && <span class="org">· {item.org}</span>}
									</div>
									<div class="xp-date">{item.date}</div>
								</div>
								{item.location && <div class="xp-loc">{item.location}</div>}
								<ul>
									{item.bullets.map((b) => <li>{b}</li>)}
								</ul>
							</div>
						))
					}
				</div>
			</section>

			<section>
				<div class="sec-head"><h2>Education</h2><span class="sec-rule"></span></div>
				<div class="grid2">
					{
						education.map((ed) => (
							<div class="grid2-cell">
								<div class="ed-role">{ed.role}</div>
								<div class="ed-org">{ed.org}</div>
								<div class="ed-date">{ed.date}</div>
							</div>
						))
					}
				</div>
			</section>

			<section>
				<div class="sec-head"><h2>Certifications</h2><span class="sec-rule"></span></div>
				<ul class="cert-list">
					{certifications.map((c) => <li>{c}</li>)}
				</ul>
			</section>

			<Fragment slot="close">
				<section>
					<div class="sec-head"><h2>Skills</h2><span class="sec-rule"></span></div>
					<p class="skills-row"><strong>Tools:</strong> Figma, FigJam, Claude, Claude Code, Claude Design &nbsp;&nbsp;·&nbsp;&nbsp; <strong>Languages:</strong> English (Native or Bilingual)</p>
				</section>

				<Contact />

				<div class="closing"><a href="/#work">← Back to the case studies</a></div>
			</Fragment>
		</PageFlow>
	</main>
</BaseLayout>

<style>
	.wrap {
		max-width: 800px;
		margin: 0 auto;
		padding: 0 32px;
	}
	.hero {
		padding: 56px 0 0;
	}
	h1 {
		font-size: clamp(34.5px, 5.2vw, 52px);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.02em;
		margin: 0 0 14px;
	}
	.lede {
		font-size: 19px;
		line-height: 1.75;
		color: var(--ink-mid);
		text-wrap: pretty;
		max-width: var(--measure);
		margin: 0 0 24px;
	}
	.contact-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 16px;
		font-family: var(--font-mono);
		font-size: 13px;
		letter-spacing: 0.02em;
		color: var(--ink-mid);
		margin-bottom: 30px;
	}
	.contact-row a {
		color: var(--ink-mid);
		text-decoration: none;
		border-bottom: 1px solid var(--rule);
	}
	.contact-row a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.contact-row .sep {
		color: var(--ink-soft);
		opacity: 0.5;
	}
	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 16px;
		margin-bottom: 40px;
	}
	section {
		padding-bottom: 52px;
	}
	h2 {
		font-size: 24px;
		font-weight: 500;
		letter-spacing: -0.015em;
		line-height: 1.22;
		color: var(--ink);
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 9px;
	}
	.chip {
		font-family: var(--font-ui);
		font-size: 12.5px;
		letter-spacing: 0.03em;
		color: var(--ink-mid);
		background: var(--surface);
		border: 1px solid var(--rule);
		padding: 8px 14px;
		border-radius: 20px;
	}
	.xp {
		border-top: 1px solid var(--rule);
	}
	.xp-item {
		padding: 28px 0;
	}
	.xp-item:not(:last-child) {
		border-bottom: 1px solid var(--rule);
	}
	.xp-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
		flex-wrap: wrap;
		margin-bottom: 2px;
	}
	.xp-role {
		font-family: var(--font-display);
		font-size: 20.5px;
		font-weight: 500;
		color: var(--ink);
		letter-spacing: -0.01em;
	}
	.xp-role .org {
		color: var(--ink-mid);
		font-weight: 400;
	}
	.xp-date {
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.03em;
		color: var(--ink-soft);
		white-space: nowrap;
	}
	.xp-loc {
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.03em;
		color: var(--ink-soft);
		margin-bottom: 12px;
	}
	.xp ul {
		margin: 12px 0 0;
		padding-left: 20px;
		color: var(--ink-mid);
		font-size: 15.5px;
		line-height: 1.75;
	}
	.xp-loc + ul {
		margin-top: 0;
	}
	.xp li {
		margin-bottom: 9px;
	}
	.xp li:last-child {
		margin-bottom: 0;
	}
	.grid2 {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1px;
		background: var(--rule);
		border: 1px solid var(--rule);
		border-radius: 2px;
		overflow: hidden;
	}
	.grid2-cell {
		background: var(--surface);
		padding: 20px 22px;
	}
	.ed-role {
		font-family: var(--font-display);
		font-size: 16.5px;
		font-weight: 500;
		color: var(--ink);
		margin-bottom: 3px;
	}
	.ed-org {
		font-size: 14.5px;
		color: var(--ink-mid);
		margin-bottom: 6px;
	}
	.ed-date {
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: 0.03em;
		color: var(--ink-soft);
	}
	.cert-list {
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 15.5px;
		color: var(--ink-mid);
		line-height: 2;
	}
	.cert-list li::before {
		content: "· ";
		color: var(--ink-soft);
	}
	.skills-row {
		font-size: 15.5px;
		color: var(--ink-mid);
	}
	.skills-row strong {
		color: var(--ink);
		font-weight: 600;
	}
	@media (max-width: 700px) {
		.grid2 {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 600px) {
		.wrap {
			padding: 0 20px;
		}
		h1 {
			font-size: 30px;
		}
		.lede {
			font-size: 16.5px;
		}
		h2 {
			font-size: 20.5px;
		}
		.hero {
			padding: 32px 0 0;
		}
		.xp-date {
			white-space: normal;
		}
	}
</style>
